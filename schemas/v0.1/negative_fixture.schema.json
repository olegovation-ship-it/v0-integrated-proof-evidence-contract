{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v0-ipec.example/spec/v0.1/negative_fixture.schema.json",
  "title": "V0-IPEC WP4 Negative Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "fixture_id",
    "title",
    "target_type",
    "mutation_class",
    "expected_error_code",
    "payload",
    "auxiliary"
  ],
  "properties": {
    "artifact_id": {
      "const": "V0_IPEC_WP4_NEGATIVE_FIXTURE"
    },
    "fixture_id": {
      "pattern": "^N(0[1-9]|1[0-9]|2[0-4])$",
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target_type": {
      "enum": [
        "CANONICAL_ENVELOPE",
        "THEOREM_OWNERSHIP_MAP",
        "THEOREM_RULE_CROSSWALK",
        "UPSTREAM_LOCK",
        "REPLAY_PAIR",
        "BASELINE_HASH_SET"
      ]
    },
    "mutation_class": {
      "type": "string",
      "minLength": 1
    },
    "expected_error_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "payload": {
      "type": "object"
    },
    "auxiliary": {
      "type": "object"
    }
  }
}
