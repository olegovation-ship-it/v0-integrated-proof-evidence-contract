{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v0-ipec.example/spec/v0.1/outcome_binding_registry.schema.json",
  "title": "V0-IPEC Outcome Binding Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "contract_id",
    "version",
    "date",
    "status",
    "rule_binding_count",
    "procedural_binding_count",
    "rule_bindings",
    "procedural_bindings",
    "records_sha256"
  ],
  "properties": {
    "artifact_id": {
      "const": "V0_IPEC_WP4_OUTCOME_BINDING_REGISTRY"
    },
    "contract_id": {
      "const": "V0-IPEC-0.1"
    },
    "version": {
      "const": "0.1"
    },
    "date": {
      "type": "string"
    },
    "status": {
      "const": "WP4_OUTCOME_BINDINGS_FROZEN"
    },
    "rule_binding_count": {
      "const": 36
    },
    "procedural_binding_count": {
      "const": 11
    },
    "rule_bindings": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "theorem_id",
          "on_violation_outcome",
          "binding_basis",
          "conditional"
        ],
        "properties": {
          "rule_id": {
            "$ref": "https://v0-ipec.example/spec/v0.1/common.schema.json#/$defs/rule_id"
          },
          "theorem_id": {
            "$ref": "https://v0-ipec.example/spec/v0.1/common.schema.json#/$defs/theorem_id"
          },
          "on_violation_outcome": {
            "$ref": "https://v0-ipec.example/spec/v0.1/common.schema.json#/$defs/typed_outcome_code"
          },
          "binding_basis": {
            "type": "string",
            "minLength": 1
          },
          "conditional": {
            "type": "boolean"
          }
        }
      }
    },
    "procedural_bindings": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "procedural_id",
          "code",
          "outcome",
          "logical_policy"
        ],
        "properties": {
          "procedural_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "const": "INCONCLUSIVE_UNSUPPORTED_FRAGMENT"
          },
          "logical_policy": {
            "const": "PROCEDURAL_DIAGNOSTIC_NEVER_BECOMES_THEOREM_BACKED_REJECTION"
          }
        }
      }
    },
    "records_sha256": {
      "$ref": "https://v0-ipec.example/spec/v0.1/common.schema.json#/$defs/sha256"
    }
  }
}
